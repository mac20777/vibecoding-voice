#include <windows.h>

#define VIBE_STRINGIFY_INNER(value) #value
#define VIBE_STRINGIFY(value) VIBE_STRINGIFY_INNER(value)
#define VIBE_VERSION_STRING \
  VIBE_STRINGIFY(VIBE_VERSION_MAJOR) "." \
  VIBE_STRINGIFY(VIBE_VERSION_MINOR) "." \
  VIBE_STRINGIFY(VIBE_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VIBE_VERSION_MAJOR,VIBE_VERSION_MINOR,VIBE_VERSION_PATCH,0
 PRODUCTVERSION VIBE_VERSION_MAJOR,VIBE_VERSION_MINOR,VIBE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "mac20777\0"
      VALUE "FileDescription", "VibeCoding Voice Virtual Microphone Publisher\0"
      VALUE "FileVersion", VIBE_VERSION_STRING "\0"
      VALUE "InternalName", "vibecoding-virtual-mic-publisher\0"
      VALUE "OriginalFilename", "vibecoding-virtual-mic-publisher.exe\0"
      VALUE "ProductName", "VibeCoding Voice\0"
      VALUE "ProductVersion", VIBE_VERSION_STRING "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
