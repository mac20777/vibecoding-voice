{
  "name": "@mac20777/vibecoding-voice",
  "version": "0.5.11",
  "private": false,
  "description": "Voice-driven AI coding bridge and Windows desktop app for ESP32 e-paper devices or global-hotkey USB microphones with Inject, Codex, Claude, and Chinese-to-English/Korean/Japanese voice translation.",
  "author": "mac20777",
  "type": "module",
  "main": "desktop/main.cjs",
  "files": [
    "desktop",
    "src",
    "scripts",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".env.example"
  ],
  "bin": {
    "vibe": "scripts/vibe.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mac20777/vibecoding-voice.git"
  },
  "bugs": {
    "url": "https://github.com/mac20777/vibecoding-voice/issues"
  },
  "homepage": "https://github.com/mac20777/vibecoding-voice#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node src/server.mjs --doctor",
    "test": "node --test",
    "test:reconnect": "node scripts/reconnect-smoke.mjs",
    "console": "node scripts/console.mjs",
    "vibe": "node scripts/vibe.mjs",
    "remote:xiaomi": "node scripts/xiaomi-remote-input.mjs",
    "remote:xiaomi:doctor": "node scripts/xiaomi-remote-input.mjs --doctor",
    "remote:xiaomi:fix-hid": "node scripts/xiaomi-remote-input.mjs --fix-hid",
    "predesktop:dev": "node scripts/windows/build-input-helper.mjs",
    "desktop:dev": "electron .",
    "virtual-mic:validate-driver": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/validate-virtual-microphone-driver.ps1 -AllowMissing",
    "virtual-mic:build-driver": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-virtual-microphone-driver.ps1 -Configuration Release",
    "windows:prepare-desktop": "node scripts/windows/fetch-usbpcap-installer.mjs && node scripts/windows/build-remote-broker.mjs && node scripts/windows/build-input-helper.mjs && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/windows/build-virtual-microphone-publisher.ps1 && npm run virtual-mic:validate-driver",
    "predesktop:dist": "npm run windows:prepare-desktop",
    "desktop:dist": "electron-builder --win nsis",
    "predesktop:dist:signed": "npm run windows:prepare-desktop",
    "desktop:dist:signed": "electron-builder --win nsis --config.win.signAndEditExecutable=true",
    "desktop:dist:linux": "electron-builder --linux deb AppImage --x64",
    "desktop:dist:ubuntu": "electron-builder --linux dir --x64 && bash scripts/build-ubuntu-deb.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "esp32",
    "voice",
    "codex",
    "websocket",
    "stt"
  ],
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mac20777.vibecodingvoice",
    "productName": "VibeCoding Voice",
    "copyright": "Copyright © mac20777",
    "afterPack": "scripts/windows/edit-packaged-executable.cjs",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "build-assets/*.png",
      "desktop/**/*",
      "src/**/*",
      "scripts/**/*",
      "!src/windows-input-helper/**/*",
      "!src/windows-service/**/*",
      "!src/xiaomi-remote-dev-elevation.mjs",
      "!scripts/windows/bootstrap-*",
      "!scripts/windows/build-*",
      "!scripts/windows/edit-packaged-executable.cjs",
      "!scripts/windows/fetch-*",
      "!scripts/windows/validate-*",
      "!scripts/inject-key.ps1",
      "!scripts/inject-text.ps1",
      "package.json",
      "node_modules/ws/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "scripts/windows/xiaomi-usbpcap-pipe.ps1",
      "scripts/windows/install-remote-broker.ps1",
      "scripts/windows/install-virtual-microphone.ps1"
    ],
    "extraResources": [
      {
        "from": "build-assets/remote-broker",
        "to": "remote-broker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-assets/input-helper",
        "to": "input-helper",
        "filter": [
          "VibeCodingVoiceInputHelper.exe"
        ]
      },
      {
        "from": "build-assets/virtual-microphone",
        "to": "virtual-microphone",
        "filter": [
          "vibecoding-virtual-mic-publisher.exe"
        ]
      },
      {
        "from": "build-assets/virtual-microphone-driver",
        "to": "virtual-microphone-driver",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-assets/app-icon.png",
      "executableName": "VibeCoding Voice",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/app-icon.png",
      "category": "Development",
      "maintainer": "mac20777",
      "artifactName": "vibecoding-voice-${version}-ubuntu-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "include": "build-assets/installer.nsh"
    }
  }
}
