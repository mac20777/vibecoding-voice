{
  "name": "@mac20777/vibecoding-voice",
  "version": "0.2.13",
  "private": false,
  "description": "Voice-driven AI coding bridge and Windows desktop app for ESP32 e-paper devices or global-hotkey USB microphones with Inject, Codex, Claude, and Chinese-to-English/Korean/Japanese voice translation.",
  "type": "module",
  "main": "desktop/main.cjs",
  "files": [
    "desktop",
    "src",
    "scripts",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    ".env.example"
  ],
  "bin": {
    "vibe": "scripts/vibe.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mac20777/vibecoding-voice.git"
  },
  "bugs": {
    "url": "https://github.com/mac20777/vibecoding-voice/issues"
  },
  "homepage": "https://github.com/mac20777/vibecoding-voice#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node src/server.mjs --doctor",
    "test": "node --test",
    "test:reconnect": "node scripts/reconnect-smoke.mjs",
    "console": "node scripts/console.mjs",
    "vibe": "node scripts/vibe.mjs",
    "desktop:dev": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "desktop:dist:linux": "electron-builder --linux deb AppImage --x64",
    "desktop:dist:ubuntu": "electron-builder --linux dir --x64 && bash scripts/build-ubuntu-deb.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "esp32",
    "voice",
    "codex",
    "websocket",
    "stt"
  ],
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mac20777.vibecodingvoice",
    "productName": "VibeCoding Voice",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "build-assets/**/*",
      "desktop/**/*",
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "node_modules/ws/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-assets/app-icon.png",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-assets/app-icon.png",
      "category": "Development",
      "maintainer": "mac20777",
      "artifactName": "vibecoding-voice-${version}-ubuntu-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    }
  }
}
