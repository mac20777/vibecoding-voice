#
# Copy this file to .env and fill in your own credentials.
# Relative paths are resolved from the repository root.
#
STT_PROVIDER=volcengine
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANGUAGE=zh
VOLCENGINE_APP_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCENGINE_LANGUAGE=zh-CN
LAN_VOICE_BIND=0.0.0.0
LAN_VOICE_PORT=8765
LAN_DISCOVERY_ENABLED=1
LAN_DISCOVERY_PORT=8766
LAN_DISCOVERY_HOST_ID=
LAN_SHARED_SECRET=
LAN_AUTH_WINDOW_SEC=300
SEND_TARGET=codex_exec
TRANSCRIPT_DELIVERY_MODE=confirm_on_device
TEXT_INJECTION_MODE=type_and_enter
VOICE_TRANSLATION_ENABLED=0
VOICE_TRANSLATION_PROVIDER=deepseek
VOICE_TRANSLATION_API_KEY=
VOICE_TRANSLATION_MODEL=deepseek-chat
VOICE_TRANSLATION_BASE_URL=https://api.deepseek.com
VOICE_TRANSLATION_TIMEOUT_MS=12000
VOICE_TRANSLATION_PROMPT=
VOICE_TRANSLATION_TARGET_LANGUAGE=english
VOICE_TRANSLATION_SEND_MODE=target
VOICE_TRANSLATION_SEND_BILINGUAL=0
TODO_INTENT_PROVIDER=rules
TODO_INTENT_API_KEY=
TODO_INTENT_MODEL=deepseek-chat
TODO_INTENT_BASE_URL=https://api.deepseek.com
TODO_INTENT_TIMEOUT_MS=8000
TODO_FOLLOWUP_TIMEOUT_MS=30000
CODEX_COMMAND=codex
CODEX_CWD=.
CODEX_SKIP_GIT_REPO_CHECK=0
CLAUDE_COMMAND=claude
CLAUDE_CWD=.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Bash,Glob,Grep
CLAUDE_MAX_TURNS=10
CLI_TIMEOUT_SEC=300
DRY_RUN_TEXT_INJECTION=1
MOCK_TRANSCRIPT=
SAVE_DEBUG_WAV=0

# Optional Xiaomi Bluetooth Voice Remote input (Windows, USBPcap only;
# ATT parsing and mSBC decoding are built in, no Wireshark/ffmpeg needed).
# Run `npm run remote:xiaomi:doctor` after installing the required tools.
XIAOMI_REMOTE_ENABLED=0
XIAOMI_REMOTE_USBPCAP_PATH=
XIAOMI_REMOTE_USBPCAP_INTERFACE=
XIAOMI_REMOTE_USB_DEVICE=
# Adapter name filter — the default "Bluetooth" matches any brand; set a
# more specific name only if the machine has multiple Bluetooth adapters
# and the wrong one gets picked (e.g. XIAOMI_REMOTE_USB_ADAPTER_MATCH=BARROT)
XIAOMI_REMOTE_USB_ADAPTER_MATCH=
XIAOMI_REMOTE_INACTIVITY_MS=900
XIAOMI_REMOTE_SEND_TARGET=codex_exec
XIAOMI_REMOTE_HID_DEVICE_MATCH=VID&012717_PID&32B8
# Remote buttons (directions, OK, back, home, volume, menu) trigger actions;
# set XIAOMI_REMOTE_BUTTONS=0 to disable. Each button supports click/double/hold
# gestures. Override format: button.gesture=type:payload, percent-encoded:
#   types: key:enter | combo:ctrl%2Bshift%2Bp | app:chrome | text:... | prompt:NAME | system:CMD | none
#   system commands: shutdown / restart / sleep / lock. shutdown+restart ask for
#   on-screen confirmation (OK executes, Back cancels). The physical power
#   button is a regular mapping whose click defaults to system:shutdown.
#   XIAOMI_REMOTE_BUTTON_MAP=ok.double=app:chrome,back.hold=none,power.click=system:restart
# Legacy "button:key" entries still work and configure the click gesture:
#   XIAOMI_REMOTE_BUTTON_MAP=ok:enter,back:escape,menu:none
# Volume keys auto-repeat while held unless a hold action is configured.
XIAOMI_REMOTE_BUTTONS=1
XIAOMI_REMOTE_BUTTON_MAP=
# Prompt templates (JSON array). Bind a button to a template with a prompt
# action; the next voice transcript replaces {text} in the template body:
# XIAOMI_REMOTE_PROMPT_TEMPLATES=[{"name":"优化","body":"优化这段话，去掉语气词：{text}"}]
XIAOMI_REMOTE_PROMPT_TEMPLATES=
# Deprecated (no longer needed, values are ignored):
# XIAOMI_REMOTE_TSHARK_PATH / XIAOMI_REMOTE_FFMPEG_PATH / XIAOMI_REMOTE_WSL_DISTRO
